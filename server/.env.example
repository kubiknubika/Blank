# Port the API server listens on
PORT=3000

# Bind address (0.0.0.0 required inside containers)
HOST=0.0.0.0

# Path to the SQLite database file (created and migrated automatically)
# DB_PATH=./data/offerflow.db

# Set to "false" to skip seeding demo data into an empty database
SEED_ON_EMPTY=true

# debug | info | warn | error | silent
LOG_LEVEL=info

# How long to wait for in-flight requests on SIGTERM before forcing exit
SHUTDOWN_TIMEOUT_MS=10000

# How long a SQLite writer waits for the lock before failing (ms).
# node:sqlite defaults to 0 → instant "database is locked" under contention.
DB_BUSY_TIMEOUT_MS=5000

# Comma-separated origins allowed to make state-changing requests,
# e.g. a separately hosted frontend: TRUSTED_ORIGINS=https://app.example.com
# Same-origin requests are always allowed; no Origin (curl) is allowed too.
TRUSTED_ORIGINS=

# Comma-separated Host header allowlist (DNS-rebinding defense).
# Empty = disabled, which dynamic preview hostnames require.
# Set in real deployments: TRUSTED_HOSTS=offerflow.example.com
TRUSTED_HOSTS=
